 namespace {
+#ifdef HX_WINDOWS
+FILE* OpenGcPauseTimeline()
+{
+   wchar_t path[32768];
+   DWORD length = GetEnvironmentVariableW(L"NOVAFLARE_GC_PAUSE_TIMELINE", path, 32768);
+   if (!length || length >= 32768) return nullptr;
+   FILE* file = _wfopen(path, L"wb");
+   if (file)
+   {
+      fputs("begin_qpc,end_qpc,qpc_frequency,thread_id,major,force_compact\n", file);
+      fflush(file);
+   }
+   return file;
+}
+
+std::uint64_t GcPauseCounter()
+{
+   LARGE_INTEGER counter;
+   QueryPerformanceCounter(&counter);
+   return static_cast<std::uint64_t>(counter.QuadPart);
+}
+
+void WriteGcPause(FILE* file, std::uint64_t begin, bool major, bool forceCompact)
+{
+   const auto end = GcPauseCounter();
+   LARGE_INTEGER frequency;
+   QueryPerformanceFrequency(&frequency);
+   fprintf(file, "%llu,%llu,%llu,%lu,%d,%d\n",
+      static_cast<unsigned long long>(begin), static_cast<unsigned long long>(end),
+      static_cast<unsigned long long>(frequency.QuadPart), GetCurrentThreadId(),
+      major ? 1 : 0, forceCompact ? 1 : 0);
+   fflush(file);
+}
+#endif
