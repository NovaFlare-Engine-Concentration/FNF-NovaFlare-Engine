+	bool SDLApplication::WaitForRenderRetry () {
+		if (!renderRetryRequested || inBackground || !OpenGLBindings::CanRender() ||
+			!OpenGLBindings::isMultiThreaded) return false;
+
+		auto* thread = OpenGLBindings::renderThread;
+		if (!thread || !thread->IsRunning() || thread->CurrentSwapInterval() == 0) return false;
+
+		// The worker can wake us first, but presentation must not postpone an update.
+		const auto now = SDL_GetPerformanceCounter ();
+		if (nextUpdateCounter > now) {
+			auto nanoseconds = (nextUpdateCounter - now) * 1000000000ULL / performanceFrequency;
+			// Return periodically to poll SDL events at lower update rates.
+			if (nanoseconds > 8000000ULL) nanoseconds = 8000000ULL;
+			thread->WaitForPendingFrames (std::chrono::nanoseconds(nanoseconds));
+		}
+		return true;
+	}
+	#endif
 
 
