+	class CairoHandleRegistry {
+	public:
+		void* Find (void* nativeObject) {
+			std::lock_guard<std::mutex> lock (mutex);
+			const auto entry = handles.find (nativeObject);
+			return entry == handles.end () ? nullptr : entry->second;
+		}
+
+		void Remember (void* nativeObject, void* wrapper) {
+			std::lock_guard<std::mutex> lock (mutex);
+			handles[nativeObject] = wrapper;
+		}
+
+		void Forget (void* nativeObject) {
+			std::lock_guard<std::mutex> lock (mutex);
+			handles.erase (nativeObject);
+		}
+
+	private:
+		std::mutex mutex;
+		std::unordered_map<void*, void*> handles;
+	};
+
+	static CairoHandleRegistry cairoObjects;
 
 
