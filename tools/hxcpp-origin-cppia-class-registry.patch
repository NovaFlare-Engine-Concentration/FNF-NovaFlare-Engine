+// Only remove or restore the class if no later registration has replaced it.
+void _hx_ReplaceClassIfSame(const String &inClassName, Class inExpected, Class inReplacement)
+{
+   if (!sClassMap) return;
+   ClassMap::iterator found = sClassMap->find(inClassName);
+   if (found == sClassMap->end() || found->second.mPtr != inExpected.mPtr) return;
+   if (inReplacement.mPtr) found->second = inReplacement;
+   else sClassMap->erase(found);
+}
