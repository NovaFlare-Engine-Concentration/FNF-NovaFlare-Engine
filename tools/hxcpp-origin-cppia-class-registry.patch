+// Restore the closest still-live overwritten CPPIA class, but never replace
+// a newer registration or an existing native class.
+static void unregisterCppiaClass(hx::Class inClass)
+{
+   CppiaClass *current = dynamic_cast<CppiaClass *>(inClass.mPtr);
+   if (!current) return;
+   hx::Class fallback = current->previousCppia;
+   while (fallback.mPtr)
+   {
+      CppiaClass *prior = dynamic_cast<CppiaClass *>(fallback.mPtr);
+      if (!prior || !prior->info->unloaded) break;
+      fallback = prior->previousCppia;
+   }
+   _hx_ReplaceClassIfSame(current->mName, inClass, fallback);
+}
 
 hx::Class_obj *createCppiaClass(CppiaClassInfo *inInfo) { return new CppiaClass(inInfo); }
 
