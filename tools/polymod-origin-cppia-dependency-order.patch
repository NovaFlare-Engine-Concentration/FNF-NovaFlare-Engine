+package polymod.hscript._internal;
+
+import haxe.io.Bytes;
+import polymod.hscript._internal.PolymodCppiaScanner;
+using StringTools;
+typedef ModuleSummary = {var exports:Array<String>; var references:Array<String>; var declared:Array<String>;}
+class DependencyOrder {
+ static function normalize(s:String):String {if(s==null)return '';s=StringTools.replace(s,'::','.');while(s.startsWith('.'))s=s.substr(1);if(s.startsWith('Array.'))return 'Array';return s;}
+ public static function analyze(data:Bytes):Null<ModuleSummary> {
+  try {
+   var exports=ManifestExports.read(data);if(exports==null)return null;
+   var scan=PolymodCppiaScanner.scan(data,['gameVersion'=>true],false);
+   if(!scan.walked || scan.binary || scan.suspect || scan.unknownTokens.length>0)return null;
+   var declared:Array<String>=[];
+   for(id in scan.ancestry.keys()) {if(id<0 || id>=scan.types.length)return null;declared.push(normalize(scan.types[id]));}
+   return {exports:[for(x in exports) normalize(x)], references:[for(x in scan.types) normalize(x)], declared:declared};
+  } catch (_:Dynamic) {return null;}
+ }
+ /** Return original order when metadata is unknown, names collide, or dependencies cycle. */
+ public static function plan(modules:Array<Null<ModuleSummary>>):Array<Int> {
+  var original=[for(i in 0...modules.length) i];
+  var owners:Map<String,Int>=[];
+  for(i in 0...modules.length) {
+   var m=modules[i]; if(m==null)return original;
+   for(name in m.exports) {if(name=='' || owners.exists(name))return original;owners.set(name,i);}
+  }
+  var deps:Array<Array<Int>>=[for(_ in modules) []];
+  for(i in 0...modules.length) {
+   var m=modules[i];
+   for(name in m.references) {
+    if(name=='' || m.declared.contains(name) || !owners.exists(name))continue;
+    var provider=owners.get(name); if(provider!=i && !deps[i].contains(provider))deps[i].push(provider);
+   }
+  }
+  var result:Array<Int>=[];var done:Map<Int,Bool>=[];
+  while(result.length<modules.length) {
+   var chosen=-1;
+   for(i in 0...modules.length) {
+    if(done.exists(i))continue;
+    var ready=true;for(dep in deps[i])if(!done.exists(dep)){ready=false;break;}
+    if(ready){chosen=i;break;}
+   }
+   if(chosen<0)return original;
+   done.set(chosen,true);result.push(chosen);
+  }
+  return result;
+ }
+}
