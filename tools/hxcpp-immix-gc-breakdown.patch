+void WriteDetailedGcPause(FILE* file, const GcPauseSample &sample, bool major, bool forceCompact)
+{
+   LARGE_INTEGER frequency;
+   QueryPerformanceFrequency(&frequency);
+   fprintf(file, "%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%lu,%d,%d,"
+      "%d,%d,%d,%d,%d,%u,%d,"
+      "%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ","
+      "%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ","
+      "%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ","
+      "%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 ",%" PRIu64 "\n",
+      sample.begin, sample.cursor, static_cast<std::uint64_t>(frequency.QuadPart), GetCurrentThreadId(),
+      major ? 1 : 0, forceCompact ? 1 : 0, sample.majorRequested ? 1 : 0, sample.generational ? 1 : 0,
+      sample.fullReclaim ? 1 : 0, sample.gameplay ? 1 : 0, sample.preparing ? 1 : 0,
+      sample.markPasses, sample.defragged ? 1 : 0,
+      sample.rendezvous, sample.setup, sample.markSetup, sample.roots, sample.stacks, sample.traversal,
+      sample.zombies, sample.finalizers, sample.markTail, sample.reclaim, sample.largeSweep, sample.defrag,
+      sample.heapPrepare, sample.freeList, sample.collectorTail, sample.release,
+      sample.blocksBefore, sample.blocksAfter, sample.largeBefore, sample.largeAfter,
+      sample.retainedRowBytes, sample.workingBudgetBytes);
+   fflush(file);
+}
