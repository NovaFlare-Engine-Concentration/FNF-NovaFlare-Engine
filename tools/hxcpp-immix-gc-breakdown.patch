+struct GcPauseSample
+{
+   std::uint64_t begin, cursor;
+   std::uint64_t rendezvous, setup, markSetup, roots, stacks, traversal, zombies, finalizers, markTail;
+   std::uint64_t reclaim, largeSweep, defrag, heapPrepare, freeList, collectorTail, release;
+   std::uint64_t blocksBefore, blocksAfter, largeBefore, largeAfter, retainedRowBytes, workingBudgetBytes;
+   unsigned markPasses;
+   bool majorRequested, generational, fullReclaim, gameplay, preparing, defragged;
+
+   void Advance(std::uint64_t &phase)
+   {
+      const auto now = GcPauseCounter();
+      phase += now - cursor;
+      cursor = now;
+   }
+};
