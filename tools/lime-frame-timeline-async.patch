+
+        void Enqueue(const char* bytes, std::size_t size) {
+            try {
+                std::string chunk(bytes, size);
+                {
+                    std::lock_guard<std::mutex> lock(mutex);
+                    if (stopping) return;
+                    if (pending.size() >= MaxPending) {
